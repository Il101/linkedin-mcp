# LinkedIn API — obtain from https://www.linkedin.com/developers/apps
# Required scopes: openid, w_member_social
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here

# MCP Server security (optional, but strongly recommended for remote deployment)
# Generate a secret: openssl rand -hex 32
# When set, the /sse endpoint requires: Authorization: Bearer <MCP_SECRET_PATH>
MCP_SECRET_PATH=your_secret_key_here

# Server port (Railway sets this automatically)
PORT=8000
